{
  "$defs": {
    "AbsenceConclusion": {
      "enum": [
        "not_found_in_probe",
        "evidence_requires_review",
        "incomplete_probe"
      ],
      "title": "AbsenceConclusion",
      "type": "string"
    },
    "AbsenceProbeResult": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "title": "Protocol Version",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "searches": {
          "items": {
            "$ref": "#/$defs/CompletedSearchRecord"
          },
          "title": "Searches",
          "type": "array"
        },
        "unique_candidate_chunk_ids": {
          "items": {
            "pattern": "^chk_[0-9a-f]{16}$",
            "type": "string"
          },
          "title": "Unique Candidate Chunk Ids",
          "type": "array"
        },
        "opened_chunk_ids": {
          "items": {
            "pattern": "^chk_[0-9a-f]{16}$",
            "type": "string"
          },
          "title": "Opened Chunk Ids",
          "type": "array"
        },
        "exact_metric_occurrences": {
          "items": {
            "$ref": "#/$defs/MetricOccurrence"
          },
          "title": "Exact Metric Occurrences",
          "type": "array"
        },
        "unresolved_predicate_occurrences": {
          "items": {
            "$ref": "#/$defs/MetricOccurrence"
          },
          "title": "Unresolved Predicate Occurrences",
          "type": "array"
        },
        "supporting_value_candidates": {
          "items": {
            "$ref": "#/$defs/ValueCandidate"
          },
          "title": "Supporting Value Candidates",
          "type": "array"
        },
        "conclusion": {
          "$ref": "#/$defs/AbsenceConclusion"
        }
      },
      "required": [
        "protocol_version",
        "metric",
        "searches",
        "unique_candidate_chunk_ids",
        "opened_chunk_ids",
        "exact_metric_occurrences",
        "unresolved_predicate_occurrences",
        "supporting_value_candidates",
        "conclusion"
      ],
      "title": "AbsenceProbeResult",
      "type": "object"
    },
    "BindingProfile": {
      "enum": [
        "direct_copula",
        "direct_reported",
        "colon",
        "dated_direct",
        "same_sentence_anaphoric",
        "next_sentence_anaphoric"
      ],
      "title": "BindingProfile",
      "type": "string"
    },
    "ClaimStatus": {
      "enum": [
        "verified",
        "conflict",
        "date_variant",
        "not_found",
        "unverified",
        "possible_conflict"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "CompletedSearchRecord": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "normalized_query": {
          "minLength": 1,
          "title": "Normalized Query",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "mode": {
          "enum": [
            "dense",
            "lexical",
            "hybrid"
          ],
          "title": "Mode",
          "type": "string"
        },
        "top_k": {
          "maximum": 20,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "document_ids": {
          "items": {
            "type": "string"
          },
          "title": "Document Ids",
          "type": "array"
        },
        "date_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date From"
        },
        "date_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date To"
        },
        "signature": {
          "minLength": 1,
          "title": "Signature",
          "type": "string"
        },
        "result_chunk_ids": {
          "items": {
            "pattern": "^chk_[0-9a-f]{16}$",
            "type": "string"
          },
          "title": "Result Chunk Ids",
          "type": "array"
        },
        "result_count": {
          "minimum": 0,
          "title": "Result Count",
          "type": "integer"
        },
        "exact_metric_hit_count": {
          "minimum": 0,
          "title": "Exact Metric Hit Count",
          "type": "integer"
        },
        "completion_status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Completion Status",
          "type": "string"
        }
      },
      "required": [
        "query",
        "normalized_query",
        "mode",
        "top_k",
        "signature",
        "result_count",
        "exact_metric_hit_count",
        "completion_status"
      ],
      "title": "CompletedSearchRecord",
      "type": "object"
    },
    "DraftObservation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ObservationKind"
        },
        "value_text": {
          "minLength": 1,
          "title": "Value Text",
          "type": "string"
        },
        "temporal_anchor": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Anchor"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "value_text",
        "evidence"
      ],
      "title": "DraftObservation",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "pattern": "^chk_[0-9a-f]{16}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "metric_anchor": {
          "minLength": 1,
          "title": "Metric Anchor",
          "type": "string"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "exact_assertion": {
          "minLength": 1,
          "title": "Exact Assertion",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/EvidenceRelation",
          "default": "supports"
        }
      },
      "required": [
        "chunk_id",
        "metric_anchor",
        "exact_quote",
        "exact_assertion"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "EvidenceRelation": {
      "enum": [
        "supports",
        "contradicts",
        "contextualizes"
      ],
      "title": "EvidenceRelation",
      "type": "string"
    },
    "MetricOccurrence": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "pattern": "^chk_[0-9a-f]{16}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "sentence": {
          "title": "Sentence",
          "type": "string"
        },
        "span": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Span",
          "type": "array"
        }
      },
      "required": [
        "chunk_id",
        "sentence",
        "span"
      ],
      "title": "MetricOccurrence",
      "type": "object"
    },
    "ObservationKind": {
      "enum": [
        "reported_level",
        "reported_rate",
        "reported_per_share",
        "reported_delta",
        "reported_bound",
        "target",
        "forecast",
        "component",
        "range"
      ],
      "title": "ObservationKind",
      "type": "string"
    },
    "ReceiptConfiguration": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "reasoning_effort": {
          "title": "Reasoning Effort",
          "type": "string"
        },
        "embedding_model": {
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_dimensions": {
          "title": "Embedding Dimensions",
          "type": "integer"
        },
        "embedding_l2_normalized": {
          "title": "Embedding L2 Normalized",
          "type": "boolean"
        },
        "turbovec_version": {
          "title": "Turbovec Version",
          "type": "string"
        },
        "turbovec_bit_width": {
          "title": "Turbovec Bit Width",
          "type": "integer"
        },
        "retrieval_modes": {
          "items": {
            "type": "string"
          },
          "title": "Retrieval Modes",
          "type": "array"
        },
        "parallel_tool_calls": {
          "title": "Parallel Tool Calls",
          "type": "boolean"
        },
        "max_turns": {
          "title": "Max Turns",
          "type": "integer"
        },
        "max_tool_calls": {
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_searches": {
          "title": "Max Searches",
          "type": "integer"
        },
        "max_top_k": {
          "title": "Max Top K",
          "type": "integer"
        },
        "max_opened_chunks": {
          "title": "Max Opened Chunks",
          "type": "integer"
        },
        "max_opened_tokens": {
          "title": "Max Opened Tokens",
          "type": "integer"
        },
        "max_document_inspections": {
          "title": "Max Document Inspections",
          "type": "integer"
        },
        "max_inspection_pages": {
          "title": "Max Inspection Pages",
          "type": "integer"
        },
        "max_inspection_characters": {
          "title": "Max Inspection Characters",
          "type": "integer"
        },
        "soft_timeout_seconds": {
          "title": "Soft Timeout Seconds",
          "type": "number"
        },
        "hard_timeout_seconds": {
          "title": "Hard Timeout Seconds",
          "type": "number"
        },
        "max_model_output_tokens_per_call": {
          "default": 8000,
          "title": "Max Model Output Tokens Per Call",
          "type": "integer"
        },
        "model_token_reservation_per_run": {
          "default": 100000,
          "title": "Model Token Reservation Per Run",
          "type": "integer"
        },
        "trace_include_sensitive_data": {
          "title": "Trace Include Sensitive Data",
          "type": "boolean"
        },
        "openai_client_max_retries": {
          "title": "Openai Client Max Retries",
          "type": "integer"
        },
        "tool_execution_concurrency": {
          "title": "Tool Execution Concurrency",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "reasoning_effort",
        "embedding_model",
        "embedding_dimensions",
        "embedding_l2_normalized",
        "turbovec_version",
        "turbovec_bit_width",
        "retrieval_modes",
        "parallel_tool_calls",
        "max_turns",
        "max_tool_calls",
        "max_searches",
        "max_top_k",
        "max_opened_chunks",
        "max_opened_tokens",
        "max_document_inspections",
        "max_inspection_pages",
        "max_inspection_characters",
        "soft_timeout_seconds",
        "hard_timeout_seconds",
        "trace_include_sensitive_data",
        "openai_client_max_retries",
        "tool_execution_concurrency"
      ],
      "title": "ReceiptConfiguration",
      "type": "object"
    },
    "ReceiptEvent": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "occurred_at": {
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "previous_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Previous Hash",
          "type": "string"
        },
        "event_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Hash",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "type",
        "occurred_at",
        "payload",
        "previous_hash",
        "event_hash"
      ],
      "title": "ReceiptEvent",
      "type": "object"
    },
    "ReceiptOpenAICall": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "operation": {
          "enum": [
            "embedding",
            "model"
          ],
          "title": "Operation",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Id"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Id"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "ended_at": {
          "title": "Ended At",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "token_usage": {
          "additionalProperties": true,
          "title": "Token Usage",
          "type": "object"
        },
        "retry_count": {
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        }
      },
      "required": [
        "sequence",
        "operation",
        "model",
        "response_id",
        "request_id",
        "started_at",
        "ended_at",
        "duration_ms",
        "token_usage",
        "retry_count",
        "error"
      ],
      "title": "ReceiptOpenAICall",
      "type": "object"
    },
    "ReceiptProvenance": {
      "additionalProperties": false,
      "properties": {
        "application_version": {
          "title": "Application Version",
          "type": "string"
        },
        "git_commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Git Commit Sha"
        },
        "dependency_lock_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dependency Lock Digests",
          "type": "object"
        },
        "agent_instruction_hash": {
          "title": "Agent Instruction Hash",
          "type": "string"
        },
        "tool_schema_hash": {
          "title": "Tool Schema Hash",
          "type": "string"
        },
        "verifier_version": {
          "title": "Verifier Version",
          "type": "string"
        },
        "binding_contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binding Contract Sha256",
          "type": "string"
        },
        "numeric_contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Numeric Contract Sha256",
          "type": "string"
        },
        "absence_protocol_version": {
          "title": "Absence Protocol Version",
          "type": "string"
        },
        "absence_protocol_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Absence Protocol Sha256",
          "type": "string"
        },
        "receipt_derivation": {
          "default": "live",
          "enum": [
            "live",
            "contract_migration"
          ],
          "title": "Receipt Derivation",
          "type": "string"
        },
        "source_receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Receipt Sha256"
        },
        "source_verifier_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Verifier Version"
        },
        "image_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Revision"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trace Id"
        },
        "sealed_at": {
          "title": "Sealed At",
          "type": "string"
        },
        "event_chain_head": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Chain Head",
          "type": "string"
        }
      },
      "required": [
        "application_version",
        "git_commit_sha",
        "dependency_lock_digests",
        "agent_instruction_hash",
        "tool_schema_hash",
        "verifier_version",
        "binding_contract_sha256",
        "numeric_contract_sha256",
        "absence_protocol_version",
        "absence_protocol_sha256",
        "image_revision",
        "trace_id",
        "sealed_at",
        "event_chain_head"
      ],
      "title": "ReceiptProvenance",
      "type": "object"
    },
    "ReceiptRehearsal": {
      "additionalProperties": false,
      "properties": {
        "source_receipt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Receipt Sha256",
          "type": "string"
        },
        "source_run_id": {
          "title": "Source Run Id",
          "type": "string"
        },
        "validated": {
          "const": true,
          "title": "Validated",
          "type": "boolean"
        },
        "reverified": {
          "const": true,
          "title": "Reverified",
          "type": "boolean"
        },
        "source_verifier_version": {
          "title": "Source Verifier Version",
          "type": "string"
        },
        "current_verifier_version": {
          "title": "Current Verifier Version",
          "type": "string"
        },
        "version_drift": {
          "title": "Version Drift",
          "type": "boolean"
        }
      },
      "required": [
        "source_receipt_sha256",
        "source_run_id",
        "validated",
        "reverified",
        "source_verifier_version",
        "current_verifier_version",
        "version_drift"
      ],
      "title": "ReceiptRehearsal",
      "type": "object"
    },
    "ValueCandidate": {
