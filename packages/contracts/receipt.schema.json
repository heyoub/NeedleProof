          "type": "string"
        },
        "document_name": {
          "title": "Document Name",
          "type": "string"
        },
        "physical_page_index": {
          "title": "Physical Page Index",
          "type": "integer"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
