        },
        "temporal_value_bound": {
          "title": "Temporal Value Bound",
          "type": "boolean"
        },
        "observation_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationKind"
            },
            {
              "type": "null"
            }
          ],
